# Supabase PostgreSQL connection (pooled via PgBouncer)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL direct connection (for migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Encryption key for connector credentials (32-byte hex string = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# OpenRouter (LLM pipeline)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="anthropic/claude-sonnet-4"
# Optional: override the model used for per-automation analysis (falls back to OPENROUTER_MODEL)
OPENROUTER_PER_AUTOMATION_MODEL=""

# Portfolio demo mode (set "true" to enable demo login + daily cron reset)
DEMO_MODE="false"
# Bearer secret for the demo-reset cron endpoint (only needed when DEMO_MODE="true")
CRON_SECRET=""

# n8n support widget (Epic 18) — app-level, set in Vercel prod too
N8N_SUPPORT_WEBHOOK_URL="https://your-n8n-host/webhook/expliq-support"
N8N_SUPPORT_WEBHOOK_SECRET="your-shared-webhook-secret"

# n8n-MCP (Epic 18) — LOCAL ONLY, build-time workflow authoring; never set in Vercel
N8N_API_URL="https://your-n8n-host/api/v1"
N8N_API_KEY="your-n8n-api-key"
