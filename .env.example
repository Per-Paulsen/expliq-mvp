# Environment variables reference for expliq-mvp.
#
# Secrets are managed in Doppler, NOT in a local .env. For local development:
#   doppler run -- npm run dev        (resolves Surface-1 app secrets from Doppler `expliq-mvp`)
#
# This file documents WHICH variables the app and tooling expect, with placeholder values only.
# - Surface 1 (app)         -> Doppler project `expliq-mvp` (dev/prd; prd syncs to Vercel)
# - Surface 2 (MCP tooling) -> Windows user-env (machine-level; used by .mcp.json, not the app)
# - Surface 3 (n8n box)     -> Doppler project `expliq-n8n-box` + the n8n credential store on the box

# --- Surface 1: app (read at runtime by Next.js / Auth.js / Prisma) ---

# Supabase PostgreSQL connection (pooled via PgBouncer)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
AUTH_URL="http://localhost:3000"
# Required in production (behind Vercel's proxy); set "true" there. Not needed locally.
AUTH_TRUST_HOST="true"

# Encryption key for connector credentials (32-byte hex string = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# OpenRouter (LLM pipeline)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="anthropic/claude-sonnet-4"
# Optional: override the model used for per-automation analysis (falls back to anthropic/claude-haiku-4-5)
OPENROUTER_PER_AUTOMATION_MODEL=""

# Portfolio demo mode (set "true" to enable demo login + daily cron reset)
DEMO_MODE="false"
# Bearer secret for the demo-reset cron endpoint (only needed when DEMO_MODE="true")
CRON_SECRET=""

# n8n support widget (Epic 18) — app-level egress to the n8n webhook; set in Vercel prod too
N8N_SUPPORT_WEBHOOK_URL="https://your-n8n-host/webhook/expliq-support"
N8N_SUPPORT_WEBHOOK_SECRET="your-shared-webhook-secret"

# --- Surface 2: Claude Code / MCP tooling (LOCAL ONLY; lives in Windows user-env, never in Vercel) ---
# Build-time n8n workflow authoring from Claude Code, referenced by .mcp.json via ${VAR}.

N8N_MCP_API_URL="https://your-n8n-host/api/v1"
N8N_MCP_API_KEY="your-n8n-api-key"
