# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# obsidian
.obsidian/

# n8n API exploration — contains real instance data (credentials, workflow details)
n8n-api-examples/fairtix/**/*.json
# Allow analysis markdown files
!n8n-api-examples/fairtix/**/*.md

# Local dev artifacts: never commit, never deploy (see DEPLOY-PORTFOLIO.md).
# Production builds from `main` via Vercel git-integration; only tracked files ship.
/screenshots/
.playwright-mcp/
.claude/projects/
.claude/settings.local.json

# n8n box backups (encrypted credential exports) — never commit, even if _resources/ gets tracked.
_resources/n8n-backups/
*.tgz
