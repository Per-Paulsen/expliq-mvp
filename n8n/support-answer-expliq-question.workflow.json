                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       540,
                                       0
                                   ],
                      "parameters":  {
                                         "jsCode":  "const docs = $input.all();\nconst chunks = docs.map(d =\u003e {\n  const j = d.json || {};\n  return (j.document \u0026\u0026 j.document.pageContent) || j.pageContent || j.text || \u0027\u0027;\n}).filter(Boolean);\nconst context = chunks.length\n  ? chunks.map((c, i) =\u003e `[Chunk ${i + 1}]\\n${c}`).join(\u0027\\n\\n---\\n\\n\u0027)\n  : \u0027(no relevant knowledge base entries found)\u0027;\nconst input = $(\u0027Execute Workflow Trigger\u0027).first().json || {};\nconst message = input.query || input.message || \u0027\u0027;\nconst history = Array.isArray(input.history) ? input.history : [];\nconst historyText = history.map(h =\u003e `${h.role}: ${h.content}`).join(\u0027\\n\u0027) || \u0027(none)\u0027;\nreturn [{ json: { context, message, historyText } }];"
                                     }
                  },
                  {
                      "id":  "llm",
                      "name":  "Answer (Claude)",
                      "type":  "@n8n/n8n-nodes-langchain.chainLlm",
                      "typeVersion":  1.9,
                      "position":  [
                                       800,
                                       0
                                   ],
                      "parameters":  {
                                         "promptType":  "define",
                                         "text":  "=You are Expliq\u0027s in-app support assistant. Expliq is an automation-intelligence platform that analyzes a user\u0027s n8n workflows and surfaces governance signals, risk levels, business processes, and prioritized recommendations.\n\nAnswer the user\u0027s QUESTION using ONLY the information in the CONTEXT below plus the CONVERSATION so far. The CONTEXT holds excerpts from Expliq\u0027s official knowledge base.\n\nRules:\n- Use ONLY the CONTEXT. Never use outside knowledge and never invent Expliq features, numbers, screens, or behavior.\n- If the CONTEXT does not contain enough information to answer, set \"reply\" to exactly: I don\u0027t have enough information to answer that. Do not guess.\n- Keep \"reply\" concise and directly useful (one short paragraph).\n- Set \"category\" to exactly one of: bug, feature-request, question, urgent.\n- Return your answer as JSON matching the required schema.\n\nCONTEXT:\n{{ $json.context }}\n\nCONVERSATION SO FAR:\n{{ $json.historyText }}\n\nUSER QUESTION:\n{{ $json.message }}",
                                         "hasOutputParser":  true
                                     }
                  },
