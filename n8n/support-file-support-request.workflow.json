                                         "inputSchema":  "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": { \"type\": \"string\", \"enum\": [\"bug\", \"feature-request\", \"question\", \"urgent\"] },\n    \"reply\": { \"type\": \"string\" },\n    \"actionsTaken\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"type\": { \"type\": \"string\", \"enum\": [\"github-issue\", \"linear-ticket\", \"slack\", \"none\"] },\n          \"ref\": { \"type\": [\"string\", \"null\"] }\n        },\n        \"required\": [\"type\", \"ref\"]\n      }\n    },\n    \"slackSummary\": { \"type\": \"string\" }\n  },\n  \"required\": [\"category\", \"reply\", \"actionsTaken\", \"slackSummary\"]\n}"
