                  {
                      "id":  "buildAudit",
                      "name":  "Build audit",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1340,
                                       0
                                   ],
                      "parameters":  {
                                         "jsCode":  "const fmt = $json.output || {};\nconst input = $(\u0027Execute Workflow Trigger\u0027).first().json || {};\nconst user = input.user || {};\nconst ctx = input.context || {};\nconst category = fmt.category || \u0027unknown\u0027;\nconst actions = Array.isArray(fmt.actionsTaken) ? fmt.actionsTaken : [];\nconst emojiMap = { bug: \u0027🐛\u0027, \u0027feature-request\u0027: \u0027💡\u0027, question: \u0027❓\u0027, urgent: \u0027🚨\u0027 };\nconst emoji = emojiMap[category] || \u0027🏷️\u0027;\nconst actionLine = actions.length ? actions.map(a =\u003e a.type + \u0027: \u0027 + (a.ref || \u0027n/a\u0027)).join(\u0027, \u0027) : \u0027none (answered from knowledge base)\u0027;\nconst rawMsg = (input.message || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\nconst msgTrunc = rawMsg.length \u003e 200 ? rawMsg.slice(0, 200) + \u0027…\u0027 : rawMsg;\nconst when = input.timestamp || new Date().toISOString();\nconst wsSuffix = ctx.workspaceId ? \u0027 (ws \u0027 + ctx.workspaceId + \u0027)\u0027 : \u0027\u0027;\nconst urgentPrefix = category === \u0027urgent\u0027 ? \u0027\u003c!here\u003e \u0027 : \u0027\u0027;\nconst lines = [urgentPrefix + emoji + \u0027 *\u0027 + category.toUpperCase() + \u0027* support request\u0027, \u0027*Ref:* exec-\u0027 + $execution.id, \u0027*User:* \u0027 + (user.email || \u0027unknown\u0027) + wsSuffix, \u0027*Page:* \u0027 + (ctx.pagePath || \u0027n/a\u0027), \u0027*Asked:* \"\u0027 + msgTrunc + \u0027\"\u0027, \u0027*Action:* \u0027 + actionLine, \u0027*When:* \u0027 + when];\nconst auditText = lines.join(\u0027\\n\u0027);\nreturn [{ json: { output: fmt, auditText } }];"
                                     }
                  },
