{
  "name": "Expliq Support — KB Indexer",
  "nodes": [
    {
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "listkb",
      "name": "List KB files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        420,
        0
      ],
      "parameters": {
        "url": "https://api.github.com/repos/Per-Paulsen/expliq-mvp/contents/n8n/knowledge?ref=feature/epic-18-n8n-support-triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "expliq-rag-indexer"
            }
          ]
        }
      },
      "retryOnFail": true
    },
    {
      "id": "fetchkb",
      "name": "Fetch KB file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        640,
        0
      ],
      "parameters": {
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "retryOnFail": true
    },
    {
      "id": "pgv",
      "name": "Index into pgvector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "mode": "insert",
        "tableName": "expliq_kb_vectors"
      },
      "credentials": {
        "postgres": {
          "id": "ru7V4Tzqrw6ZSvSf",
          "name": "expliq-rag PGVector (Postgres)"
        }
      }
    },
    {
      "id": "loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        980,
        240
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "simple"
      }
    },
    {
      "id": "emb",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "model": "nomic-embed-text:latest"
      },
      "credentials": {
        "ollamaApi": {
          "id": "SijHtsthwmtboAFE",
          "name": "Box Ollama"
        }
      }
    },
    {
      "id": "84074f30-50ce-4ec7-b632-7f8270b5abf6",
      "name": "Split into sections",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "jsCode": "const out=[];for(const item of $input.all()){const md=item.json.data||'';const lines=md.split('\\n');const titleLine=lines.find(l=>l.startsWith('# '));const docTitle=titleLine?titleLine.slice(2).trim():'';const sections=md.split('\\n## ');for(let i=1;i<sections.length;i++){const body=sections[i].trim();if(!body)continue;const text='# '+docTitle+'\\n\\n## '+body;const heading=body.split('\\n')[0].trim();out.push({json:{text,source:docTitle,heading}});}}return out;"
      }
    },
    {
      "id": "189b9e0d-2e58-4812-bc46-255f5903c163",
      "name": "Clear table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        200,
        0
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "DROP TABLE IF EXISTS expliq_kb_vectors;"
      },
      "credentials": {
        "postgres": {
          "id": "ru7V4Tzqrw6ZSvSf",
          "name": "expliq-rag PGVector (Postgres)"
        }
      }
    },
    {
      "id": "aac2de78-3daa-43b6-b0cd-1dcf41503f78",
      "name": "Doc: Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -360
      ],
      "parameters": {
        "width": 1340,
        "height": 140,
        "color": 4,
        "content": "## Expliq Support — KB Indexer\nRun on demand (Execute) when the KB changes. Reads `n8n/knowledge/*.md` from GitHub, chunks by H2 heading, embeds with Ollama, and stores vectors in the dedicated Supabase pgvector store. The **answer workflow** reads these vectors on each chat request; this workflow only writes them."
      }
    },
    {
      "id": "bce499fa-3478-47e7-ae8e-ea8ae84cce23",
      "name": "Doc: 1 Clear",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        -180
      ],
      "parameters": {
        "width": 200,
        "height": 150,
        "color": 5,
        "content": "### 1. Clear\nDrops the vector table so each run rebuilds the KB from scratch — idempotent, no duplicate chunks."
      }
    },
    {
      "id": "985f170b-3843-486b-a86d-9f2a6591cb91",
      "name": "Doc: 2 List",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        -180
      ],
      "parameters": {
        "width": 200,
        "height": 150,
        "color": 5,
        "content": "### 2. List\nLists `n8n/knowledge/` via GitHub's public Contents API (repo is public, no token). Git = single source of truth."
      }
    },
    {
      "id": "42a34ef5-317b-4a7f-8f27-d5e5857ed864",
      "name": "Doc: 3 Fetch",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        620,
        -180
      ],
      "parameters": {
        "width": 200,
        "height": 150,
        "color": 5,
        "content": "### 3. Fetch\nDownloads each KB file as raw markdown (one item per file; retries on transient errors)."
      }
    },
    {
      "id": "60c6cd96-144f-4c33-8df1-74212e13a664",
      "name": "Doc: 4 Chunk",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        840,
        -180
      ],
      "parameters": {
        "width": 200,
        "height": 150,
        "color": 5,
        "content": "### 4. Chunk\nSplits each file by H2 heading into one self-contained chunk per topic (prefixed with the doc title)."
      }
    },
    {
      "id": "15c6542a-04e7-40e3-a3ac-3975acc79754",
      "name": "Doc: 5 Embed & store",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1060,
        -180
      ],
      "parameters": {
        "width": 260,
        "height": 150,
        "color": 5,
        "content": "### 5. Embed & store\nEmbeds each chunk with Ollama (`nomic-embed-text`, 768-dim) and inserts into `expliq_kb_vectors`. Sub-nodes: Data Loader + Embeddings."
      }
    }
  ],
