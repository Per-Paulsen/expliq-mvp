generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Platform {
  n8n
}

enum ImpactLevel {
  critical
  high
  medium
  low
}

enum AutomationStatus {
  active
  inactive
  removed
}

enum AnalysisStatus {
  pending
  analyzing_workflows
  analyzing_workspace
  complete
  failed
}

// ── Models ─────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users              User[]
  connectorConfigs   ConnectorConfig[]
  automations        Automation[]
  businessProcesses  BusinessProcess[]
  recommendations    Recommendation[]
  processSuggestions ProcessSuggestion[]
  companyProfile     CompanyProfile?
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  workspaceId  String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  accounts  Account[]
  sessions  Session[]
}

model ConnectorConfig {
  id              String    @id @default(cuid())
  workspaceId     String
  platform        Platform
  instanceUrl     String
  apiKeyEncrypted String
  lastSyncAt      DateTime?
  selectedTags    String[]
  discoveryData   Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Automation {
  id                    String           @id @default(cuid())
  workspaceId           String
  externalId            String
  platform              String
  rawWorkflowJson       Json
  name                  String?
  automationLastUpdated DateTime?
  status                AutomationStatus

  // R2 LLM analysis fields
  businessNarrative     String?
  dataFlow              String?
  impact                Json?
  detectability         Json?
  timeSavingsEstimate   String?
  revenueImpactEstimate String?
  technicalEvidence     Json?
  trigger               String?
  triggerType           String?
  systemsTouched        String[]

  // R2 process mapping fields
  stepName              String?
  processId             String?
  runsPerWeek           Float?
  errorRate             Float?
  lastExecutedAt        DateTime?
  avgDurationMs         Float?
  upstreamIds           String[]
  downstreamIds         String[]

  // R2 status fields
  analysisStatus        AnalysisStatus?
  isRemoved             Boolean          @default(false)

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  process         BusinessProcess? @relation(fields: [processId], references: [id])
  recommendations Recommendation[]

  @@unique([workspaceId, externalId])
}

model BusinessProcess {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  summary       String?
  maturityLevel String?
  valueAtStake  String?
  steps         Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  automations     Automation[]
  recommendations Recommendation[]
}

model Recommendation {
  id                  String   @id @default(cuid())
  workspaceId         String
  processId           String?
  processSuggestionId String?
  automationId        String?
  type                String
  tier                String
  stepName            String?
  name                String
  brief               String?
  businessCase        String?
  evidence            Json?
  confidence          String?
  honestFraming       String?
  implementationNotes String?
  suggestedPlatform   String?
  systemSource        String?
  systemDestination   String?
  deployableJson      Json?
  impactEstimate      String?
  priorityOrder       Int      @default(0)
  affectedScope       String?
  createdAt           DateTime @default(now())

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  process           BusinessProcess?   @relation(fields: [processId], references: [id])
  processSuggestion ProcessSuggestion? @relation(fields: [processSuggestionId], references: [id])
  automation        Automation?        @relation(fields: [automationId], references: [id])
}

model ProcessSuggestion {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  description      String?
  basedOn          String?
  businessCase     String?
  connectedSystems String[]
  createdAt        DateTime @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  recommendations Recommendation[]
}

model CompanyProfile {
  id                 String         @id @default(cuid())
  workspaceId        String         @unique
  systemLandscape    Json?
  nextMoveText       String?
  nextMoveReasoning  String?
  processMetrics     Json?
  benchmarks         Json?
  insights           Json?
  aggregateEstimates Json?
  analyzedAt         DateTime?
  analysisStatus     AnalysisStatus @default(pending)
  previousSnapshot   Json?
  deltaSummary       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
