generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Platform {
  n8n
}

enum ImpactLevel {
  critical
  high
  medium
  low
}

enum AutomationStatus {
  active
  inactive
  removed
}

enum StatusOverride {
  active
  inactive
  deprecated
}

// ── Models ─────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users            User[]
  connectorConfigs ConnectorConfig[]
  automations      Automation[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  workspaceId  String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  accounts  Account[]
  sessions  Session[]
}

model ConnectorConfig {
  id              String    @id @default(cuid())
  workspaceId     String
  platform        Platform
  instanceUrl     String
  apiKeyEncrypted String
  lastSyncAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Automation {
  id                       String            @id @default(cuid())
  workspaceId              String
  externalId               String
  platform                 String
  rawWorkflowJson          Json
  name                     String?
  description              String?
  trigger                  String?
  triggerType              String?
  coreLogic                String?
  systemsTouched           String[]
  dataTypes                String[]
  businessContext          String?
  sideEffects              String[]
  impactProposal           ImpactLevel?
  impactOverride           ImpactLevel?
  owner                    String?
  reviewCadenceDays        Int               @default(30)
  lastReviewDate           DateTime?
  automationLastUpdated    DateTime?
  documentationLastUpdated DateTime?
  status                   AutomationStatus
  statusOverride           StatusOverride?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, externalId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
